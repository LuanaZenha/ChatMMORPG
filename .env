# Copie para .env e preencha sua URI do MongoDB Atlas
# Exemplo: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGO_URL=mongodb+srv://chat_db_user:012345@cluster.tgcipw6.mongodb.net/?retryWrites=true&w=majority&appName=cluster
APP_HOST=0.0.0.0
APP_PORT=8000
